# Creator access token from https://www.patreon.com/portal/registration/register-clients
PATREON_ACCESS_TOKEN=

# Optional OAuth refresh credentials. When all three are set, the server can
# refresh expired access tokens (and rotate the refresh token) automatically.
PATREON_REFRESH_TOKEN=
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=

# Optional: persist rotated tokens to this JSON file (written with mode 0600).
# PATREON_TOKEN_FILE=/absolute/path/to/patreon-tokens.json

# Optional: browser session for post create/edit/delete tools. Copy the full
# Cookie request header from a logged-in patreon.com browser session.
# PATREON_SESSION_COOKIE=session_id=...; a_csrf=...; cf_clearance=...
# Or store that header in a 0600 file:
# PATREON_SESSION_COOKIE_FILE=/absolute/path/to/patreon-cookies.txt
# Match the browser that issued the session/Cloudflare cookies when needed.
# PATREON_USER_AGENT=Mozilla/5.0 ...

# Optional overrides.
# PATREON_API_BASE_URL=https://www.patreon.com/api/oauth2/v2
# PATREON_TOKEN_URL=https://www.patreon.com/api/oauth2/token
# PATREON_WEB_BASE_URL=https://www.patreon.com
# PATREON_TIMEOUT_SECONDS=30
